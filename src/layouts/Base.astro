---
import { locales, localeAlternates, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
}

const props = Astro.props as Props;
const locale = (Astro.params.locale ?? 'en') as Locale;
// route relative to the locale root, computed from the real URL
const base = (import.meta.env.BASE_URL || '/embedkit').replace(/\/$/, '');
const prefix = `${base}/${locale}`;
const route = Astro.url.pathname.startsWith(prefix)
  ? Astro.url.pathname.slice(prefix.length)
  : '';
const site = `https://tayuluc.github.io${base}`;
const canonical = `${site}/${locale}${route}`;
const alts = localeAlternates(base, route);
const u = (path: string) => `${base}${path}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{props.title}</title>
    {props.description && <meta name="description" content={props.description} />}
    <link rel="canonical" href={canonical} />
    {Object.entries(alts).map(([lang, href]) => <link rel="alternate" hreflang={lang} href={href} />)}
    <meta property="og:title" content={props.title} />
    {props.description && <meta property="og:description" content={props.description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EmbedKit" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <script is:inline define:vars={{}}>
      document.querySelectorAll('[data-ek-lang]').forEach(function (a) {
        a.addEventListener('click', function () {
          try { localStorage.setItem('ek-lang', a.getAttribute('data-ek-lang')); } catch (e) {}
        });
      });
    </script>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href={u(`/${locale}`)}>EmbedKit</a>
      <nav class="main-nav">
        <a href={u(`/${locale}/generator/youtube`)}>YouTube</a>
        <a href={u(`/${locale}/generator/vimeo`)}>Vimeo</a>
        <a href={u(`/${locale}/generator/twitch`)}>Twitch</a>
        <a href={u(`/${locale}/generator/dailymotion`)}>Dailymotion</a>
        <a href={u(`/${locale}/generator/tiktok`)}>TikTok</a>
        <a href={u(`/${locale}/generator/spotify`)}>Spotify</a>
      </nav>
      <nav class="langs">
        {locales.map((l) => (
          <a href={u(`/${l}${route}`)} data-ek-lang={l} aria-current={l === locale ? 'page' : undefined}>{l.toUpperCase()}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root { --fg: #16181d; --muted: #5b6472; --bg: #ffffff; --accent: #0b62ff; --border: #e3e7ee; }
  @media (prefers-color-scheme: dark) { :root { --fg: #e8eaf0; --muted: #98a2b3; --bg: #0e1014; --accent: #6ea0ff; --border: #23262e; } }
  * { box-sizing: border-box; }
  body { margin: 0; font: 16px/1.55 system-ui, -apple-system, sans-serif; color: var(--fg); background: var(--bg); }
  main { max-width: 960px; margin: 0 auto; padding: 24px 16px 48px; }
  a { color: var(--accent); text-decoration: none; }
  .site-header { display: flex; align-items: center; gap: 16px; padding: 12px 16px; border-bottom: 1px solid var(--border); }
  .site-header .logo { font-weight: 700; letter-spacing: -0.02em; }
  .main-nav { display: flex; flex-wrap: wrap; gap: 10px 14px; margin-left: auto; max-width: 62%; justify-content: flex-end; }
  .main-nav a { font-size: 14px; }
  .langs a { margin-left: 10px; font-size: 13px; color: var(--muted); }
  .langs a[aria-current="page"] { color: var(--fg); font-weight: 600; }
</style>
