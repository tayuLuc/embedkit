---
import { locales, localeAlternates, t, type Locale } from '../lib/i18n.ts';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  path: string;
}

const { locale, title, description, path } = Astro.props;
const site = 'https://tayuluc.github.io/embedkit';
const canonical = `${site}${path === '/' ? '' : path}`;
const alts = localeAlternates(path);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {Object.entries(alts).map(([lang, href]) => <link rel="alternate" hreflang={lang} href={href} />)}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href={`/${locale}`}>EmbedKit</a>
      <nav class="langs">
        {locales.map((l) => (
          <a href={`/${l}${path.replace(new RegExp(`^/${locale}`), '')}`} aria-current={l === locale ? 'page' : undefined}>{l.toUpperCase()}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>EmbedKit</span>
      <span>·</span>
      <a href={`/${locale}/generator/youtube`}>{t(locale, { en: 'YouTube', ru: 'YouTube' })}</a>
      <span>·</span>
      <a href={`/${locale}/generator/vimeo`}>{t(locale, { en: 'Vimeo', ru: 'Vimeo' })}</a>
    </footer>
  </body>
</html>

<style is:global>
  :root { --fg: #16181d; --muted: #5b6472; --bg: #ffffff; --accent: #0b62ff; --border: #e3e7ee; }
  @media (prefers-color-scheme: dark) { :root { --fg: #e8eaf0; --muted: #98a2b3; --bg: #0e1014; --accent: #6ea0ff; --border: #23262e; } }
  * { box-sizing: border-box; }
  body { margin: 0; font: 16px/1.55 system-ui, -apple-system, sans-serif; color: var(--fg); background: var(--bg); }
  main { max-width: 960px; margin: 0 auto; padding: 24px 16px 48px; }
  a { color: var(--accent); text-decoration: none; }
  .site-header { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--border); }
  .site-header .logo { font-weight: 700; letter-spacing: -0.02em; }
  .langs a { margin-left: 10px; font-size: 13px; color: var(--muted); }
  .langs a[aria-current="page"] { color: var(--fg); font-weight: 600; }
  .site-footer { border-top: 1px solid var(--border); padding: 16px; text-align: center; color: var(--muted); font-size: 14px; }
  .site-footer a { color: var(--muted); }
</style>
