---
export const prerender = true;
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ru' } }];
}

import Base from '../../../layouts/Base.astro';
import { t, type Locale } from '../../../lib/i18n';

const locale = (Astro.params.locale ?? 'en') as Locale;

const ui = {
  h1: t(locale, { en: 'Google Maps embed code generator', ru: 'Генератор кода для Карт' }),
  lead: t(locale, { en: "Google Maps keeps the map state in a 'pb' link. Paste your map URL, set the size, copy the keyless iframe.", ru: "Google Maps хранит состояние карты в ссылке 'pb'. Вставь ссылку карты, задай размер, скопируй iframe без ключей." }),
  url: t(locale, { en: 'Google Maps URL', ru: 'Ссылка Google Карт' }),
  invalid: t(locale, { en: 'Paste a full Google Maps link (with the data=… part), not a maps.app short link', ru: 'Вставь полную ссылку Google Карт (с частью data=…), а не короткую maps.app' }),
  preview: t(locale, { en: 'Preview', ru: 'Превью' }),
  code: t(locale, { en: 'Embed code', ru: 'Код для вставки' }),
  copy: t(locale, { en: 'Copy', ru: 'Копировать' }),
  seoTitle: t(locale, { en: 'Google Maps embed code generator | EmbedKit', ru: 'Генератор кода для Google Карт | EmbedKit' }),
  desc: t(locale, { en: 'Turn a Google Maps link into a clean responsive iframe: keeps the official pb player, sets width and height, no API key needed.', ru: 'Ссылка Google Карт в чистый responsive iframe: официальный pb-плеер, свой размер, без API-ключа.' }),
  howTitle: t(locale, { en: 'How to embed a Google Map', ru: 'Как встроить карту Google' }),
  how: t(locale, { en: "Open the map, Share → Copy link, paste it here. Short maps.app links must be opened once in the browser to expand into the full URL — the pb blob lives behind that redirect.", ru: "Открой карту, «Поделиться» → скопируй ссылку, вставь сюда. Короткие ссылки maps.app нужно один раз открыть в браузере — блоб pb живёт за редиректом." }),
};
---
<Base title={ui.seoTitle} description={ui.desc}>
  <h1>{ui.h1}</h1>
  <p class="lead">{ui.lead}</p>
  <div class="ek" data-ek-generator="maps" data-t-invalid={ui.invalid}>
    <div class="panel">
      <label for="ek-url">{ui.url}</label>
      <input id="ek-url" type="url" placeholder="https://www.google.com/maps/place/.../data=!3m1!4b1" autocomplete="off" spellcheck="false" />
      <span id="ek-status" class="status" aria-live="polite"></span>
    </div>
    <div class="panel">
      <h2>{ui.preview}</h2>
      <div id="ek-preview" class="preview" style="aspect-ratio:auto;background:transparent"></div>
      <h2>{ui.code}</h2>
      <textarea id="ek-code" rows="4" readonly spellcheck="false"></textarea>
      <button id="ek-copy" type="button">{ui.copy}</button>
    </div>
  </div>
  <section class="seo">
    <h2>{ui.howTitle}</h2>
    <p>{ui.how}</p>
    <details>
      <summary>{t(locale, { en: 'Does it need an API key?', ru: 'Нужен ли API-ключ?' })}</summary>
      <p>{t(locale, { en: "No. The share-embed pb link is keyless; the Maps Embed API key path is a different, paid product.", ru: 'Нет. Ссылка Share → Embed (pb) работает без ключа; платный путь — Maps Embed API.' })}</p>
    </details>
    <details>
      <summary>{t(locale, { en: 'Yandex Maps too?', ru: 'А Яндекс.Карты?' })}</summary>
      <p>{t(locale, { en: 'Yandex map-widget links embed cleanly as a plain iframe; paste them into the box as well.', ru: 'Ссылки map-widget Яндекса встраиваются чистым iframe — вставляй их в это же поле.' })}</p>
    </details>
  </section>
</Base>
<script>
  import '../../../lib/generator.client.ts';
</script>
<style>
  .lead { color: var(--muted); margin-top: 4px; }
  .ek { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width: 720px) { .ek { grid-template-columns: 1fr; } }
  .panel { border: 1px solid var(--border); border-radius: 10px; padding: 16px; }
  .panel h2 { font-size: 14px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); margin: 18px 0 8px; }
  .panel h2:first-of-type { margin-top: 0; }
  label { display: block; margin: 6px 0; font-size: 14px; }
  input[type="url"], textarea { width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--fg); font: inherit; }
  textarea { font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }
  #ek-preview iframe { border: 0; border-radius: 12px; width: 100%; }
  button { margin-top: 8px; padding: 8px 16px; border: 1px solid var(--border); border-radius: 8px; background: var(--accent); color: #fff; font: inherit; cursor: pointer; }
  button[data-state="copied"]::after { content: " ✓"; }
  .status { display: block; min-height: 1.2em; font-size: 13px; color: var(--muted); margin-top: 6px; }
  .seo { margin-top: 40px; max-width: 70ch; }
  .seo h2 { font-size: 20px; }
  .seo details { border: 1px solid var(--border); border-radius: 8px; padding: 8px 12px; margin: 8px 0; }
  .seo summary { cursor: pointer; font-weight: 600; font-size: 15px; }
</style>
