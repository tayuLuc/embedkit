---
export const prerender = true;
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ru' } }];
}

import TelegramGenerator from '../../../components/TelegramGenerator.astro';

const locale = (Astro.params.locale ?? 'en') as 'en' | 'ru';
---
<TelegramGenerator locale={locale} mode="post" />
