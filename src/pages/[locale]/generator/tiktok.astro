---
export const prerender = true;
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ru' } }];
}

import Base from '../../../layouts/Base.astro';
import { t, type Locale } from '../../../lib/i18n';

const locale = (Astro.params.locale ?? 'en') as Locale;

const ui = {
  h1: t(locale, { en: 'TikTok embed code generator', ru: 'Генератор кода для TikTok' }),
  lead: t(locale, { en: 'Paste a TikTok link and copy the embed code.', ru: 'Вставь ссылку TikTok и скопируй код для вставки.' }),
  url: t(locale, { en: 'TikTok URL', ru: 'Ссылка TikTok' }),
  invalid: t(locale, { en: 'Paste a valid TikTok link', ru: 'Вставь корректную ссылку TikTok' }),
  playback: t(locale, { en: 'Playback', ru: 'Воспроизведение' }),
  appearance: t(locale, { en: 'Appearance', ru: 'Внешний вид' }),
  autoplay: t(locale, { en: 'Autoplay', ru: 'Автозапуск' }),
  loop: t(locale, { en: 'Loop', ru: 'Повтор' }),
  mute: t(locale, { en: 'Mute', ru: 'Без звука' }),
  controls: t(locale, { en: 'Player controls', ru: 'Кнопки плеера' }),
  start: t(locale, { en: 'Start at (seconds)', ru: 'Начать с (секунды)' }),
  title: t(locale, { en: 'Show title', ru: 'Показывать название' }),
  byline: t(locale, { en: 'Show author', ru: 'Показывать автора' }),
  portrait: t(locale, { en: 'Show author avatar', ru: 'Показывать аватар автора' }),
  preview: t(locale, { en: 'Preview', ru: 'Превью' }),
  code: t(locale, { en: 'Embed code', ru: 'Код для вставки' }),
  copy: t(locale, { en: 'Copy', ru: 'Копировать' }),
  copied: t(locale, { en: 'Copied', ru: 'Скопировано' }),
  seoTitle: t(locale, { en: 'TikTok embed code generator | EmbedKit', ru: 'Генератор кода для TikTok | EmbedKit' }),
  desc: t(locale, { en: 'Paste a TikTok link and get the official embed (blockquote + TikTok SDK) ready for your site.', ru: 'Вставь ссылку TikTok — получишь официальный embed (blockquote + TikTok SDK) для своего сайта.' }),
};
---

<Base title={ui.seoTitle} description={ui.desc}>
  <h1>{ui.h1}</h1>
  <p class="lead">{ui.lead}</p>

  <div class="ek" data-ek-generator="tiktok" data-t-invalid={ui.invalid} data-t-copied={ui.copied}>
    <div class="panel">
      <label for="ek-url">{ui.url}</label>
      <input id="ek-url" type="url" placeholder="https://tiktok.com/@user/video/..." autocomplete="off" spellcheck="false" />
      <span id="ek-status" class="status" aria-live="polite"></span>

          </div>

    <div class="panel">
      <h2>{ui.preview}</h2>
      <div id="ek-preview" class="preview"></div>
      <h2>{ui.code}</h2>
      <textarea id="ek-code" rows="5" readonly spellcheck="false"></textarea>
      <button id="ek-copy" type="button">{ui.copy}</button>
    </div>
  </div>
</Base>

<script>
  import '../../../lib/generator.client.ts';
</script>

<style>
  .lead { color: var(--muted); margin-top: 4px; }
  .ek { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width: 720px) { .ek { grid-template-columns: 1fr; } }
  .panel { border: 1px solid var(--border); border-radius: 10px; padding: 16px; }
  .panel h2 { font-size: 14px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); margin: 18px 0 8px; }
  .panel h2:first-of-type { margin-top: 0; }
  label { display: block; margin: 6px 0; font-size: 14px; }
  input[type="url"], input[type="text"], textarea {
    width: 100%; padding: 8px 10px; border: 1px solid var(--border); border-radius: 8px;
    background: var(--bg); color: var(--fg); font: inherit;
  }
  textarea { font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 12px; }
  .grid label { display: flex; align-items: center; gap: 8px; }
  .preview { position: relative; aspect-ratio: 9 / 16; max-height: 620px; background: #000; border-radius: 8px; overflow: hidden; }
  .preview iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .preview blockquote { position: absolute; inset: 0; margin: 0; overflow: hidden; }
  button { margin-top: 8px; padding: 8px 16px; border: 1px solid var(--border); border-radius: 8px; background: var(--accent); color: #fff; font: inherit; cursor: pointer; }
  button[data-state="copied"]::after { content: " ✓"; }
  .status { display: block; min-height: 1.2em; font-size: 13px; color: var(--muted); margin-top: 6px; }
</style>
