---
const base = (import.meta.env.BASE_URL || '/embedkit').replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>404 · EmbedKit</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <style>
      body { font: 16px/1.6 system-ui, sans-serif; margin: 0; display: grid; place-items: center; min-height: 100vh; background: #fff; color: #16181d; }
      a { color: #0b62ff; text-decoration: none; }
      .code { font-size: 72px; font-weight: 800; letter-spacing: -0.04em; margin: 0; }
      .row { text-align: center; }
    </style>
  </head>
  <body>
    <main class="row">
      <p class="code">404</p>
      <p><a href={`${base}/en/`}>EmbedKit (English)</a> · <a href={`${base}/ru/`}>EmbedKit (Русский)</a></p>
    </main>
  </body>
</html>
